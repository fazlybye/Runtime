end

local function runGodmode()
    safeDelete(game:GetService("ReplicatedStorage").Remotes.Events.Dismember)
    safeDelete(game:GetService("ReplicatedStorage").Bindables.DismemberServer)
    safeDelete(workspace.Map.MACHINERY.Regen.GeneratorTire.Generator.Engine.Functional.FlyWheel.TouchInterest)
