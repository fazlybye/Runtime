        MakeTextBlock(120)

        if isMulti then
            if cfg.Default and type(cfg.Default) == "table" then
                for _, v in ipairs(cfg.Default) do selected[v] = true end
            end
        else
            selected = cfg.Default or options[1] or ""
        end

        -- chip / value display
        local chipHolder = Instance.new("Frame")
        chipHolder.Name             = "Chips"
        chipHolder.Size             = UDim2.new(0, 110, 0, 26)
        chipHolder.Position         = UDim2.new(1, -118, 0.5, -13)
        chipHolder.BackgroundTransparency = 1
        chipHolder.ClipsDescendants = true
        chipHolder.ZIndex           = 3
        chipHolder.Parent           = holder

        local function RefreshChips()
            for _, c in ipairs(chipHolder:GetChildren()) do
                if c:IsA("Frame") or c:IsA("TextLabel") then c:Destroy() end
            end
            if isMulti then
                local x = 0
                for k, _ in pairs(selected) do
                    local chip = Instance.new("Frame")
                    chip.Size             = UDim2.new(0, 0, 0, 20)
                    chip.AutomaticSize    = Enum.AutomaticSize.X
                    chip.Position         = UDim2.new(0, x, 0, 3)
                    chip.BackgroundColor3 = T.SurfaceAlt
                    chip.BorderSizePixel  = 0
                    chip.ZIndex           = 4
                    chip.Parent           = chipHolder
                    local ccc = Instance.new("UICorner")
                    ccc.CornerRadius = UDim.new(1, 0)
                    ccc.Parent = chip
                    local cpp = Instance.new("UIPadding")
                    cpp.PaddingLeft  = UDim.new(0, 6)
                    cpp.PaddingRight = UDim.new(0, 6)
                    cpp.Parent       = chip
                    local cl = Instance.new("TextLabel")
                    cl.Text           = k
                    cl.Font           = Enum.Font.Gotham
                    cl.TextSize       = 10
                    cl.TextColor3     = T.TextSecondary
                    cl.BackgroundTransparency = 1
                    cl.Size           = UDim2.new(0, 0, 1, 0)
                    cl.AutomaticSize  = Enum.AutomaticSize.X
                    cl.ZIndex         = 5
                    cl.Parent         = chip
                    task.wait()
                    x = x + chip.AbsoluteSize.X + 4
                end
            else
                local vl = Instance.new("TextLabel")
                vl.Text           = tostring(selected)
                vl.Font           = Enum.Font.GothamBold
                vl.TextSize       = 12
                vl.TextColor3     = T.TextSecondary
                vl.BackgroundTransparency = 1
                vl.Size           = UDim2.fromScale(1, 1)
                vl.TextXAlignment = Enum.TextXAlignment.Right
                vl.ZIndex         = 4
                vl.Parent         = chipHolder
