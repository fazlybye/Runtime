        fill.BackgroundColor3 = T.SliderFill
        fill.BorderSizePixel  = 0
        fill.ZIndex           = 4
        fill.Parent           = track
        local fc = Instance.new("UICorner")
        fc.CornerRadius = UDim.new(1, 0)
        fc.Parent = fill

        -- fill glow
        local fillStroke = Instance.new("UIStroke")
        fillStroke.Color       = T.Accent
        fillStroke.Thickness   = 2
        fillStroke.Transparency = 0.6
        fillStroke.Parent      = fill

        local knob = Instance.new("Frame")
        knob.Size             = UDim2.fromOffset(16, 16)
        knob.AnchorPoint      = Vector2.new(0.5, 0.5)
        knob.Position         = UDim2.new(ratio, 0, 0.5, 0)
        knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        knob.BorderSizePixel  = 0
        knob.ZIndex           = 5
        knob.Parent           = track
        local kc2 = Instance.new("UICorner")
        kc2.CornerRadius = UDim.new(1, 0)
        kc2.Parent = knob

        local knobShadow = Instance.new("UIStroke")
        knobShadow.Color       = T.Accent
        knobShadow.Thickness   = 2
        knobShadow.Transparency = 0.5
        knobShadow.Parent      = knob

        -- tooltip
        local tooltip = Instance.new("Frame")
        tooltip.Name              = "Tooltip"
        tooltip.Size              = UDim2.fromOffset(48, 24)
        tooltip.AnchorPoint       = Vector2.new(0.5, 1)
        tooltip.Position          = UDim2.new(ratio, 0, 0, -8)
        tooltip.BackgroundColor3  = T.BackgroundAlt
        tooltip.BorderSizePixel   = 0
        tooltip.ZIndex            = 8
        tooltip.BackgroundTransparency = 1
        tooltip.Parent            = track
        local ttcr = Instance.new("UICorner")
        ttcr.CornerRadius = UDim.new(0, 6)
        ttcr.Parent = tooltip
        local ttlbl = Instance.new("TextLabel")
        ttlbl.Size             = UDim2.fromScale(1, 1)
        ttlbl.BackgroundTransparency = 1
        ttlbl.Text             = tostring(Round(current, dec))
        ttlbl.Font             = Enum.Font.GothamBold
        ttlbl.TextSize         = 11
        ttlbl.TextColor3       = T.TextPrimary
        ttlbl.ZIndex           = 9
        ttlbl.Parent           = tooltip

        local dragging = false

        local function UpdateSlider(absX)
            local trackAbsPos  = track.AbsolutePosition
            local trackAbsSize = track.AbsoluteSize
            local r = math.clamp((absX - trackAbsPos.X) / trackAbsSize.X, 0, 1)
            local val = Round(min + (max - min) * r, dec)
            current = val
            local nr = (val - min) / math.max(max - min, 0.0001)
            Tween(fill,    0.05, {Size = UDim2.new(nr, 0, 1, 0)})
            Tween(knob,    0.05, {Position = UDim2.new(nr, 0, 0.5, 0)})
            Tween(tooltip, 0.05, {Position = UDim2.new(nr, 0, 0, -8)})
            valLbl.Text  = tostring(val)
            ttlbl.Text   = tostring(val)
        end

        -- click area over track
        local hitbox = Instance.new("TextButton")
        hitbox.Size             = UDim2.new(1, 0, 0, 28)
        hitbox.Position         = UDim2.new(0, 0, 0.5, -14)
        hitbox.BackgroundTransparency = 1
        hitbox.Text             = ""
        hitbox.ZIndex           = 6
        hitbox.Parent           = track

        hitbox.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true
                tooltip.BackgroundTransparency = 0
                UpdateSlider(input.Position.X)
            end
        end)
        hitbox.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = false
                Tween(tooltip, 0.1, {BackgroundTransparency = 1})
                if cfg.Callback then task.spawn(cfg.Callback, current) end
            end
        end)
        table.insert(self._connections, UIS.InputChanged:Connect(function(input)
            if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                UpdateSlider(input.Position.X)
            end
