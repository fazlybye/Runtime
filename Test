    -- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
    elseif compType == "Slider" then
        -- â”€â”€ SLIDER â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        EnableHover()
        holder.Size = UDim2.new(1, 0, 0, 58)

        local _, titleL = MakeTextBlock(0)

        local min     = cfg.Minimum or 0
        local max     = cfg.Maximum or 100
        local dec     = cfg.DecimalCount or 0
        local current = cfg.Default or min
        current = math.clamp(current, min, max)
        local ratio   = (current - min) / math.max(max - min, 0.0001)

        -- value label
        local valLbl = Instance.new("TextLabel")
        valLbl.Text           = tostring(Round(current, dec))
        valLbl.Font           = Enum.Font.GothamBold
        valLbl.TextSize       = 12
        valLbl.TextColor3     = T.Accent
        valLbl.BackgroundTransparency = 1
        valLbl.Size           = UDim2.new(0, 50, 0, 16)
        valLbl.Position       = UDim2.new(1, -58, 0, 12)
        valLbl.TextXAlignment = Enum.TextXAlignment.Right
        valLbl.ZIndex         = 3
        valLbl.Parent         = holder

        local track = Instance.new("Frame")
        track.Size             = UDim2.new(1, -24, 0, 6)
        track.Position         = UDim2.new(0, 12, 1, -18)
        track.BackgroundColor3 = T.SurfaceAlt
        track.BorderSizePixel  = 0
        track.ZIndex           = 3
        track.Parent           = holder
