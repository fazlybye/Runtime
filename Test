        end)
        btn.MouseLeave:Connect(function()
            Tween(btn, 0.15, {BackgroundColor3 = T.SurfaceAlt, ImageColor3 = T.TextSecondary, ImageTransparency = 0.2})
        end)
        btn.MouseButton1Click:Connect(callback)
        btn.Parent = btnHolder
        return btn
    end

    -- Minimize
    MakeWinBtn(Icons.Minimize, 1, function()
        self._minimized = not self._minimized
        if self._minimized then
            Tween(window, 0.3, {Size = UDim2.new(window.Size.X.Scale, window.Size.X.Offset, 0, T.TopbarHeight)})
        else
            Tween(window, 0.3, {Size = config.Size or UDim2.fromOffset(540, 360)})
        end
    end)
    -- Close
    MakeWinBtn(Icons.Close, 2, function()
        self._closed = true
        Tween(window, 0.25, {BackgroundTransparency = 1})
        task.delay(0.28, function() window:Destroy() end)
    end)

    -- â”€â”€ Tab bar â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    local tabBar = Instance.new("ScrollingFrame")
    tabBar.Name                 = "TabBar"
    tabBar.Size                 = UDim2.new(1, 0, 0, T.TabHeight)
    tabBar.Position             = UDim2.new(0, 0, 0, T.TopbarHeight)
    tabBar.BackgroundColor3     = T.BackgroundAlt
    tabBar.BorderSizePixel      = 0
    tabBar.ScrollBarThickness   = 0
    tabBar.CanvasSize           = UDim2.new()
    tabBar.AutomaticCanvasSize  = Enum.AutomaticSize.X
    tabBar.ZIndex               = 5
    tabBar.Parent               = window

    local tabBarFill = Instance.new("Frame")
    tabBarFill.Size             = UDim2.new(1, 0, 0, 2)
    tabBarFill.Position         = UDim2.new(0, 0, 1, -2)
    tabBarFill.BackgroundColor3 = T.Border
    tabBarFill.BorderSizePixel  = 0
    tabBarFill.ZIndex           = 6
    tabBarFill.Parent           = tabBar

    local tabList = Instance.new("UIListLayout")
    tabList.FillDirection       = Enum.FillDirection.Horizontal
    tabList.VerticalAlignment   = Enum.VerticalAlignment.Center
    tabList.HorizontalAlignment = Enum.HorizontalAlignment.Center
    tabList.SortOrder           = Enum.SortOrder.LayoutOrder
    tabList.Padding             = UDim.new(0, 4)
    tabList.Parent              = tabBar

    local tabPad = Instance.new("UIPadding")
    tabPad.PaddingLeft  = UDim.new(0, 10)
    tabPad.PaddingRight = UDim.new(0, 10)
    tabPad.Parent       = tabBar

    self._tabBar  = tabBar
    self._tabList = tabList

    -- â”€â”€ Content area â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    local contentY = T.TopbarHeight + T.TabHeight
    local content  = Instance.new("Frame")
    content.Name             = "Content"
    content.Size             = UDim2.new(1, 0, 1, -contentY)
    content.Position         = UDim2.new(0, 0, 0, contentY)
    content.BackgroundTransparency = 1
    content.BorderSizePixel  = 0
    content.ClipsDescendants = true
    content.Parent           = window
    self._content = content

    -- â”€â”€ Drag â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    local dragging, dragStart, startPos
    topbar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging  = true
            dragStart = input.Position
            startPos  = window.Position
        end
    end)
    topbar.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    table.insert(self._connections, UIS.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            window.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end))

    -- â”€â”€ Resize (bottom-right) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    local resizeBtn = Instance.new("ImageButton")
    resizeBtn.Name              = "Resize"
    resizeBtn.Size              = UDim2.fromOffset(18, 18)
    resizeBtn.Position          = UDim2.new(1, -4, 1, -4)
    resizeBtn.AnchorPoint       = Vector2.new(1, 1)
    resizeBtn.BackgroundTransparency = 1
    resizeBtn.Image             = Icons.Resize
    resizeBtn.ImageColor3       = T.TextMuted
    resizeBtn.ImageTransparency = 0.5
    resizeBtn.ZIndex            = 10
    resizeBtn.Parent            = window

    local resizing, resizeStart, resizeStartSize
    resizeBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            resizing       = true
            resizeStart    = input.Position
            resizeStartSize = window.AbsoluteSize
        end
    end)
    resizeBtn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            resizing = false
        end
    end)
    table.insert(self._connections, UIS.InputChanged:Connect(function(input)
        if resizing and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - resizeStart
            local minS  = config.MinimumSize or Vector2.new(300, 200)
            local newW  = math.max(resizeStartSize.X + delta.X, minS.X)
            local newH  = math.max(resizeStartSize.Y + delta.Y, minS.Y)
            window.Size = UDim2.fromOffset(newW, newH)
            content.Size = UDim2.new(1, 0, 1, -contentY)
        end
    end))

    -- â”€â”€ Popup overlay â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    local popupOverlay = Instance.new("TextButton")
    popupOverlay.Name             = "PopupOverlay"
    popupOverlay.Size             = UDim2.fromScale(1, 1)
    popupOverlay.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    popupOverlay.BackgroundTransparency = 1
    popupOverlay.ZIndex           = 9
    popupOverlay.Text             = ""
    popupOverlay.Visible          = false
    popupOverlay.Parent           = window
    self._popupOverlay = popupOverlay

    -- entrance animation
    window.BackgroundTransparency = 1
    window.Position = UDim2.new(window.Position.X.Scale, window.Position.X.Offset, window.Position.Y.Scale - 0.04, window.Position.Y.Offset)
    Spring(window, 0.5, {
        BackgroundTransparency = 0,
        Position = config.Position or UDim2.fromScale(0.5, 0.5)
    })

    self._notificationHolder = self:_BuildNotificationHolder()

    return self
end

-- â”€â”€ Notification holder â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
