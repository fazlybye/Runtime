-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
--  TABS
-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
function WindModal:AddTab(title)
    local T     = self._theme
    local tabObj = {}
    tabObj._components = {}
    tabObj._title      = title

    -- tab button
    local textSize = TextService:GetTextSize(title, 13, Enum.Font.GothamBold, Vector2.new(9999,9999))
    local tabBtn = Instance.new("TextButton")
    tabBtn.Name             = title
    tabBtn.Size             = UDim2.new(0, textSize.X + 28, 1, 0)
    tabBtn.BackgroundTransparency = 1
    tabBtn.Text             = title
    tabBtn.Font             = Enum.Font.GothamBold
    tabBtn.TextSize         = 13
    tabBtn.TextColor3       = T.TextMuted
    tabBtn.ZIndex           = 6
    tabBtn.LayoutOrder      = #self._tabs + 1
    tabBtn.Parent           = self._tabBar

    -- active underline
    local underline = Instance.new("Frame")
    underline.Name              = "Underline"
    underline.Size              = UDim2.new(1, -20, 0, 2)
    underline.Position          = UDim2.new(0, 10, 1, -2)
    underline.BackgroundColor3  = T.Accent
    underline.BackgroundTransparency = 1
    underline.BorderSizePixel   = 0
    underline.ZIndex            = 7
    underline.Parent            = tabBtn
    local ulc = Instance.new("UICorner")
    ulc.CornerRadius = UDim.new(1, 0)
    ulc.Parent = underline

    -- scrolling content frame
    local scroll = Instance.new("ScrollingFrame")
    scroll.Name                 = title
    scroll.Size                 = UDim2.fromScale(1, 1)
    scroll.BackgroundTransparency = 1
    scroll.BorderSizePixel      = 0
    scroll.ScrollBarThickness   = 3
    scroll.ScrollBarImageColor3 = T.ScrollBar
    scroll.ScrollBarImageTransparency = 0.3
    scroll.CanvasSize           = UDim2.new()
    scroll.AutomaticCanvasSize  = Enum.AutomaticSize.Y
    scroll.Visible              = false
    scroll.ZIndex               = 2
    scroll.Parent               = self._content

    local layout = Instance.new("UIListLayout")
    layout.SortOrder           = Enum.SortOrder.LayoutOrder
    layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    layout.Padding             = UDim.new(0, 6)
    layout.Parent              = scroll

    local pad = Instance.new("UIPadding")
    pad.PaddingTop    = UDim.new(0, 10)
    pad.PaddingBottom = UDim.new(0, 10)
    pad.PaddingLeft   = UDim.new(0, 8)
    pad.PaddingRight  = UDim.new(0, 8)
    pad.Parent        = scroll

    tabObj._scroll    = scroll
    tabObj._tabBtn    = tabBtn
    tabObj._underline = underline
    tabObj._window    = self

    local idx = #self._tabs + 1
    self._tabs[idx] = tabObj

    tabBtn.MouseButton1Click:Connect(function()
        self:SetTab(title)
    end)

    -- select first tab automatically
    if idx == 1 then
        self:SetTab(title)
    end

    -- â”€â”€ component factory â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    local New = {}
    setmetatable(New, {__index = function(_, compType)
        return function(_, config2)
            return self:_SpawnComponent(compType, config2, tabObj)
        end
    end})
    tabObj.New = New

    return tabObj
end

function WindModal:SetTab(title)
    local T = self._theme
    for _, tab in ipairs(self._tabs) do
        local active = (tab._title == title)
        tab._scroll.Visible = active
        Tween(tab._tabBtn, 0.2, {TextColor3 = active and T.TextPrimary or T.TextMuted})
        Tween(tab._underline, 0.2, {BackgroundTransparency = active and 0 or 1})
    end
    self._currentTab = title
end

-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
--  COMPONENT BUILDER
-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
function WindModal:_SpawnComponent(compType, cfg, tab)
    local T = self._theme
    cfg = cfg or {}

    -- base holder
    local holder = Instance.new("Frame")
    holder.Name              = compType
    holder.Size              = UDim2.new(1, 0, 0, 46)
    holder.BackgroundColor3  = T.Surface
    holder.BorderSizePixel   = 0
    holder.AutomaticSize     = Enum.AutomaticSize.Y
    holder.LayoutOrder       = #tab._components + 1
    holder.Parent            = tab._scroll

    local holderCorner = Instance.new("UICorner")
    holderCorner.CornerRadius = UDim.new(0, T.CornerRadius)
    holderCorner.Parent = holder

    local holderStroke = Instance.new("UIStroke")
    holderStroke.Color       = T.Border
    holderStroke.Thickness   = 1
    holderStroke.Transparency = 0.6
    holderStroke.Parent      = holder

    -- hover effect
    local highlight = Instance.new("Frame")
    highlight.Name              = "Highlight"
    highlight.Size              = UDim2.fromScale(1, 1)
    highlight.BackgroundColor3  = Color3.fromRGB(255,255,255)
    highlight.BackgroundTransparency = 1
    highlight.ZIndex            = 0
    highlight.Parent            = holder
    local hc = Instance.new("UICorner")
    hc.CornerRadius = UDim.new(0, T.CornerRadius)
    hc.Parent = highlight

    -- left text block
    local function MakeTextBlock(padRight)
        local txtFrame = Instance.new("Frame")
        txtFrame.BackgroundTransparency = 1
        txtFrame.Size                   = UDim2.new(1, -(padRight or 0), 1, 0)
        txtFrame.Position               = UDim2.fromOffset(0, 0)
        txtFrame.AutomaticSize          = Enum.AutomaticSize.Y
        txtFrame.ZIndex                 = 2
        txtFrame.Parent                 = holder

        local tlist = Instance.new("UIListLayout")
        tlist.SortOrder           = Enum.SortOrder.LayoutOrder
        tlist.VerticalAlignment   = Enum.VerticalAlignment.Center
        tlist.Padding             = UDim.new(0, 2)
        tlist.Parent              = txtFrame

        local tpad = Instance.new("UIPadding")
        tpad.PaddingLeft   = UDim.new(0, 12)
        tpad.PaddingTop    = UDim.new(0, 10)
        tpad.PaddingBottom = UDim.new(0, 10)
        tpad.Parent        = txtFrame

        local titleLbl = Instance.new("TextLabel")
        titleLbl.Text           = cfg.Title or ""
        titleLbl.Font           = Enum.Font.GothamBold
        titleLbl.TextSize       = 13
        titleLbl.TextColor3     = T.TextPrimary
        titleLbl.TextXAlignment = Enum.TextXAlignment.Left
        titleLbl.TextWrapped    = true
        titleLbl.BackgroundTransparency = 1
        titleLbl.Size           = UDim2.new(1, 0, 0, 0)
        titleLbl.AutomaticSize  = Enum.AutomaticSize.Y
        titleLbl.LayoutOrder    = 0
        titleLbl.ZIndex         = 2
        titleLbl.Parent         = txtFrame

        local descLbl
        if cfg.Description and cfg.Description ~= "" then
            descLbl = Instance.new("TextLabel")
            descLbl.Text           = cfg.Description
            descLbl.Font           = Enum.Font.Gotham
            descLbl.TextSize       = 11
            descLbl.TextColor3     = T.TextSecondary
            descLbl.TextXAlignment = Enum.TextXAlignment.Left
            descLbl.TextWrapped    = true
            descLbl.BackgroundTransparency = 1
            descLbl.Size           = UDim2.new(1, 0, 0, 0)
            descLbl.AutomaticSize  = Enum.AutomaticSize.Y
            descLbl.LayoutOrder    = 1
            descLbl.ZIndex         = 2
            descLbl.Parent         = txtFrame
        end
        return txtFrame, titleLbl, descLbl
    end

    local api = {}
    table.insert(tab._components, api)

    -- â”€â”€ Hover effect for interactive components â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    local function EnableHover()
        holder.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement then
                Tween(highlight, 0.15, {BackgroundTransparency = 0.96})
            end
        end)
        holder.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement then
                Tween(highlight, 0.15, {BackgroundTransparency = 1})
            end
        end)
    end

    -- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
    if compType == "Section" then
        -- â”€â”€ SECTION (WindUI-style) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        holder:Destroy()
        local sec = Instance.new("Frame")
        sec.Name              = "Section"
        sec.Size              = UDim2.new(1, 0, 0, 28)
        sec.BackgroundTransparency = 1
        sec.LayoutOrder       = #tab._components
        sec.Parent            = tab._scroll

        local line = Instance.new("Frame")
        line.Size             = UDim2.new(1, 0, 0, 1)
        line.Position         = UDim2.new(0, 0, 0.5, 0)
        line.BackgroundColor3 = T.Border
        line.BorderSizePixel  = 0
        line.Parent           = sec
        local lc = Instance.new("UICorner")
        lc.CornerRadius = UDim.new(1, 0)
        lc.Parent = line

        local badge = Instance.new("Frame")
        badge.Size             = UDim2.new(0, 0, 0, 20)
        badge.AutomaticSize    = Enum.AutomaticSize.X
        badge.Position         = UDim2.new(0, 12, 0.5, -10)
        badge.BackgroundColor3 = T.SurfaceAlt
        badge.BorderSizePixel  = 0
        badge.ZIndex           = 2
        badge.Parent           = sec
        local bc2 = Instance.new("UICorner")
        bc2.CornerRadius = UDim.new(1, 0)
        bc2.Parent = badge
        local bp = Instance.new("UIPadding")
        bp.PaddingLeft  = UDim.new(0, 8)
        bp.PaddingRight = UDim.new(0, 8)
        bp.Parent = badge

        local secLbl = Instance.new("TextLabel")
        secLbl.Text           = cfg.Title or "Section"
        secLbl.Font           = Enum.Font.GothamBold
        secLbl.TextSize       = 11
        secLbl.TextColor3     = T.TextMuted
        secLbl.BackgroundTransparency = 1
        secLbl.Size           = UDim2.new(0, 0, 1, 0)
        secLbl.AutomaticSize  = Enum.AutomaticSize.X
        secLbl.ZIndex         = 3
        secLbl.Parent         = badge

        api.SetTitle = function(_, t) secLbl.Text = t end
        return api

    -- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
    elseif compType == "Paragraph" then
        -- â”€â”€ PARAGRAPH â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        local pFrame = Instance.new("Frame")
        pFrame.Name             = "Paragraph"
        pFrame.Size             = UDim2.new(1, 0, 0, 0)
        pFrame.AutomaticSize    = Enum.AutomaticSize.Y
        pFrame.BackgroundColor3 = T.Surface
        pFrame.BorderSizePixel  = 0
        pFrame.LayoutOrder      = #tab._components
        pFrame.Parent           = tab._scroll
        holder:Destroy()

        local pc = Instance.new("UICorner")
        pc.CornerRadius = UDim.new(0, T.CornerRadius)
        pc.Parent = pFrame

        local pStroke = Instance.new("UIStroke")
        pStroke.Color       = T.Border
        pStroke.Thickness   = 1
        pStroke.Transparency = 0.6
        pStroke.Parent      = pFrame

        local pList = Instance.new("UIListLayout")
        pList.SortOrder   = Enum.SortOrder.LayoutOrder
        pList.Padding     = UDim.new(0, 4)
        pList.Parent      = pFrame

        local pPad = Instance.new("UIPadding")
        pPad.PaddingTop    = UDim.new(0, 12)
        pPad.PaddingBottom = UDim.new(0, 12)
        pPad.PaddingLeft   = UDim.new(0, 14)
        pPad.PaddingRight  = UDim.new(0, 14)
        pPad.Parent        = pFrame

        local pTitle = Instance.new("TextLabel")
        pTitle.Text           = cfg.Title or ""
        pTitle.Font           = Enum.Font.GothamBold
        pTitle.TextSize       = 13
        pTitle.TextColor3     = T.TextPrimary
        pTitle.TextXAlignment = Enum.TextXAlignment.Left
        pTitle.TextWrapped    = true
        pTitle.BackgroundTransparency = 1
        pTitle.Size           = UDim2.new(1, 0, 0, 0)
        pTitle.AutomaticSize  = Enum.AutomaticSize.Y
        pTitle.LayoutOrder    = 0
        pTitle.Parent         = pFrame

        local pContent = Instance.new("TextLabel")
