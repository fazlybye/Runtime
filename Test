        api.SetValue = function(_, v)
            currentKey = tostring(v)
            keyLabel.Text = currentKey
        end
        api.GetValue = function() return currentKey end
        return api
    end

    -- â”€â”€ Fallback for unknown types â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    return api
end

