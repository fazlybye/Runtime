                bc3.CornerRadius = UDim.new(0, 6)
                bc3.Parent = box
                box:CaptureFocus()
                box.FocusLost:Connect(function()
                    local v = tonumber(box.Text)
                    if v then
                        current = math.clamp(Round(v, dec), min, max)
                        local nr = (current - min) / math.max(max - min, 0.0001)
                        Tween(fill,  0.15, {Size     = UDim2.new(nr, 0, 1, 0)})
                        Tween(knob,  0.15, {Position = UDim2.new(nr, 0, 0.5, 0)})
                        valLbl.Text = tostring(current)
                        if cfg.Callback then task.spawn(cfg.Callback, current) end
                    end
                    box:Destroy()
                end)
            end
        end)

        api.SetValue = function(_, v)
            current = math.clamp(Round(v, dec), min, max)
            local nr = (current - min) / math.max(max - min, 0.0001)
            Tween(fill,  0.15, {Size     = UDim2.new(nr, 0, 1, 0)})
            Tween(knob,  0.15, {Position = UDim2.new(nr, 0, 0.5, 0)})
            valLbl.Text = tostring(current)
        end
