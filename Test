--  NOTIFICATIONS
-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
function WindModal:Notify(cfg)
    cfg = cfg or {}
    local T      = self._theme
    local typeColors = {
        Success = T.Success, Error = T.Error, Warning = T.Warning, Info = T.Info
    }
    local typeIcons = {
        Success = Icons.Success, Error = Icons.Error, Warning = Icons.Warning, Info = Icons.Info
    }
    local accentColor = typeColors[cfg.Type or "Info"] or T.Info
    local icon        = typeIcons[cfg.Type or "Info"]  or Icons.Info

    local card = Instance.new("Frame")
    card.Name             = "Notification"
    card.Size             = UDim2.fromOffset(250, 0)
    card.AutomaticSize    = Enum.AutomaticSize.Y
    card.BackgroundColor3 = T.BackgroundAlt
    card.BorderSizePixel  = 0
    card.BackgroundTransparency = 1
    card.Parent           = self._notificationHolder

    local cc = Instance.new("UICorner")
    cc.CornerRadius = UDim.new(0, 12)
    cc.Parent = card
    local cs = Instance.new("UIStroke")
    cs.Color       = T.Border
    cs.Thickness   = 1
    cs.Transparency = 0.4
    cs.Parent      = card

    -- left accent bar
    local bar = Instance.new("Frame")
    bar.Size             = UDim2.new(0, 3, 1, 0)
    bar.BackgroundColor3 = accentColor
    bar.BorderSizePixel  = 0
    bar.ZIndex           = 2
    bar.Parent           = card
    local brc = Instance.new("UICorner")
    brc.CornerRadius = UDim.new(1, 0)
    brc.Parent = bar

    local content = Instance.new("Frame")
    content.Size             = UDim2.new(1, -14, 0, 0)
    content.Position         = UDim2.fromOffset(14, 0)
    content.AutomaticSize    = Enum.AutomaticSize.Y
    content.BackgroundTransparency = 1
    content.ZIndex           = 2
    content.Parent           = card

    local layout = Instance.new("UIListLayout")
    layout.Padding   = UDim.new(0, 3)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent    = content

    local pad = Instance.new("UIPadding")
    pad.PaddingTop    = UDim.new(0, 12)
    pad.PaddingBottom = UDim.new(0, 12)
    pad.PaddingLeft   = UDim.new(0, 8)
    pad.Parent        = content

    -- icon + title row
    local titleRow = Instance.new("Frame")
    titleRow.Size             = UDim2.new(1, 0, 0, 18)
    titleRow.BackgroundTransparency = 1
    titleRow.LayoutOrder      = 0
    titleRow.ZIndex           = 3
    titleRow.Parent           = content

    local nIcon = Instance.new("ImageLabel")
    nIcon.Image               = icon
    nIcon.Size                = UDim2.fromOffset(14, 14)
    nIcon.Position            = UDim2.new(0, 0, 0.5, -7)
    nIcon.BackgroundTransparency = 1
    nIcon.ImageColor3         = accentColor
    nIcon.ZIndex              = 3
    nIcon.Parent              = titleRow

    local nTitle = Instance.new("TextLabel")
    nTitle.Text           = cfg.Title or "Notification"
    nTitle.Font           = Enum.Font.GothamBold
    nTitle.TextSize       = 13
    nTitle.TextColor3     = T.TextPrimary
    nTitle.TextXAlignment = Enum.TextXAlignment.Left
    nTitle.BackgroundTransparency = 1
    nTitle.Size           = UDim2.new(1, -20, 1, 0)
    nTitle.Position       = UDim2.fromOffset(20, 0)
    nTitle.ZIndex         = 3
    nTitle.Parent         = titleRow

    local nDesc = Instance.new("TextLabel")
    nDesc.Text           = cfg.Description or ""
    nDesc.Font           = Enum.Font.Gotham
    nDesc.TextSize       = 11
    nDesc.TextColor3     = T.TextSecondary
    nDesc.TextXAlignment = Enum.TextXAlignment.Left
    nDesc.TextWrapped    = true
    nDesc.BackgroundTransparency = 1
    nDesc.Size           = UDim2.new(1, -4, 0, 0)
    nDesc.AutomaticSize  = Enum.AutomaticSize.Y
    nDesc.LayoutOrder    = 1
    nDesc.ZIndex         = 3
    nDesc.Parent         = content

    -- progress bar
    local prog = Instance.new("Frame")
    prog.Size             = UDim2.new(1, 0, 0, 2)
    prog.BackgroundColor3 = accentColor
    prog.BackgroundTransparency = 0.4
    prog.BorderSizePixel  = 0
    prog.LayoutOrder      = 2
    prog.ZIndex           = 3
    prog.Parent           = content
    local prc = Instance.new("UICorner")
    prc.CornerRadius = UDim.new(1, 0)
    prc.Parent = prog

    -- dismiss button
    local dismiss = Instance.new("TextButton")
    dismiss.Size              = UDim2.fromOffset(16, 16)
    dismiss.Position          = UDim2.new(1, -20, 0, 8)
    dismiss.BackgroundTransparency = 1
    dismiss.Text              = "âœ•"
    dismiss.Font              = Enum.Font.GothamBold
    dismiss.TextSize          = 10
    dismiss.TextColor3        = T.TextMuted
    dismiss.ZIndex            = 4
    dismiss.Parent            = card

    local duration = cfg.Duration or 5

    local function Dismiss()
        Tween(card, 0.25, {BackgroundTransparency = 1, Position = UDim2.new(1, 20, 0, 0)})
        Tween(cs, 0.25, {Transparency = 1})
        task.delay(0.25, function() card:Destroy() end)
    end

    dismiss.MouseButton1Click:Connect(Dismiss)
    card.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            Dismiss()
        end
    end)

    -- entrance
    card.Position = UDim2.new(1, 20, 0, 0)
    Tween(card, 0.3, {BackgroundTransparency = 0, Position = UDim2.fromScale(0, 0)})

    -- progress drain
    local elapsed = 0
    local conn
    conn = RunService.Heartbeat:Connect(function(dt)
        elapsed = elapsed + dt
        local r = 1 - math.clamp(elapsed / duration, 0, 1)
        prog.Size = UDim2.new(r, 0, 0, 2)
        if elapsed >= duration then
            conn:Disconnect()
            Dismiss()
        end
    end)
end

