-- Always Sprint + Speed Loop
local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local sprintingActive = false
local speedConnection = nil

local function startSpeedLoop()
    if speedConnection then return end
    speedConnection = RunService.RenderStepped:Connect(function()
        if sprintingActive and character and character.Parent then
            humanoid.WalkSpeed = 35
        end
    end)
end

local function stopSpeedLoop()
    if speedConnection then
        speedConnection:Disconnect()
        speedConnection = nil
    end
    if humanoid and character and character.Parent then
        humanoid.WalkSpeed = 16
    end
end

local function enableSprint()
    sprintingActive = true
    startSpeedLoop()
end

local function disableSprint()
    sprintingActive = false
    stopSpeedLoop()
end

Players.LocalPlayer.CharacterAdded:Connect(function(newChar)
    character = newChar
    humanoid = character:WaitForChild("Humanoid")
    if sprintingActive then
        startSpeedLoop()
    end
end)

-- PC Tab - F Key Ragdoll Function
local fKeyActive = false

local function executeFKeyRagdoll()
    local character = Players.LocalPlayer.Character
    if not character then return end
    
    local leftHand = character:FindFirstChild("LeftHand")
    if not leftHand then return end
    
    local map = workspace:FindFirstChild("Map")
    if not map then return end
    
    local model = map:FindFirstChild("Model")
    if not model then return end
    
    local baseplate = model:FindFirstChild("Baseplate")
    if not baseplate then return end
    
    local args = {
        leftHand,
        true,
        Vector3.new(42.70556640625, -0.25, 51.104034423828125),
        baseplate
    }
    
    local replicatedStorage = game:GetService("ReplicatedStorage")
    local remotes = replicatedStorage:FindFirstChild("Remotes")
    if not remotes then return end
    
    local events = remotes:FindFirstChild("Events")
    if not events then return end
    
    local ragdollRequest = events:FindFirstChild("Ragdoll_Request")
    if not ragdollRequest then return end
    
    ragdollRequest:FireServer(unpack(args))
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.F then
        if fKeyActive then
            executeFKeyRagdoll()
        end
    end
end)

