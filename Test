--  THEME SWITCHING
-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
function WindModal:SetTheme(themeNameOrTable)
    if type(themeNameOrTable) == "string" then
        self._theme = Themes[themeNameOrTable] or self._theme
    elseif type(themeNameOrTable) == "table" then
        self._theme = themeNameOrTable
    end
    -- Note: live recolor would require Fusion reactivity; for full recolor
    -- the window should be recreated. Partial tween updates can be added here.
end

-- â”€â”€ Misc â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function WindModal:SetTitle(t)
    if self._titleLabel then self._titleLabel.Text = t end
end
function WindModal:SetSubTitle(t)
    if self._subLabel then self._subLabel.Text = t end
end
function WindModal:SetTransparency(t)
    if self._window then
        Tween(self._window, 0.25, {BackgroundTransparency = t})
    end
end
function WindModal:Destroy()
    for _, conn in ipairs(self._connections) do
        conn:Disconnect()
    end
    if self._window then self._window:Destroy() end
    if self._notificationHolder then self._notificationHolder:Destroy() end
end

-- Expose themes for custom use
WindModal.Themes = Themes

return WindModal

